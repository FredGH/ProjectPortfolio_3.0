# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=tca_user
POSTGRES_PASSWORD=tca_password
POSTGRES_DB=tca_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tca_user:tca_password@localhost:5432/tca_db

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── JWT RS256 ─────────────────────────────────────────────────
# Key pair generated automatically at startup if not provided.
# To use a persistent key pair:
#   openssl genrsa -out private_key.pem 2048
#   openssl rsa -in private_key.pem -pubout -out public_key.pem
JWT_PRIVATE_KEY_PATH=./private_key.pem   # optional; auto-generated if absent
JWT_PUBLIC_KEY_PATH=./public_key.pem     # optional; auto-generated if absent
JWT_ALGORITHM=RS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=8
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Airflow ──────────────────────────────────────────────────
AIRFLOW_SECRET_KEY=supersecretkey-change-in-prod
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin

# ── dbt (override for local dev outside Docker) ───────────────
DBT_HOST=localhost
DBT_USER=tca_user
DBT_PASSWORD=tca_password
DBT_DB=tca_db

# ── PoC test client secrets (plaintext — hash stored in DB) ───
# POST /auth/token with: {"client_id": "trader_01", "client_secret": "changeme"}
TRADER_01_SECRET=changeme
COMPLIANCE_01_SECRET=changeme
CLIENT_CP_A_SECRET=changeme
