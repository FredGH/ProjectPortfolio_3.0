.env
venv/
.venv/
__pycache__/
*.pyc
.coverage

# Landing-zone data is generated at runtime (dlt/ingestion writes here) —
# never committed. The directory structure itself is kept via .gitkeep.
data/landing/*
!data/landing/.gitkeep

# dbt build artifacts (PLAN.md Step 5) — regenerated by `dbt deps`/`dbt run`.
dbt/dbt_packages/
dbt/target/
dbt/logs/
# dbt's local anonymous-usage-stats file — not part of the project.
dbt/.user.yml

# Terraform (PLAN.md Step 12) — tfvars and state hold real secrets and
# real infrastructure identifiers; never commit them. .terraform.lock.hcl
# IS committed (pins provider versions) — everything else here is not.
infra/.terraform/
infra/terraform.tfvars
infra/*.tfstate
infra/*.tfstate.backup
infra/.terraform.tfstate.lock.info
