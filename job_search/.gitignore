.env
venv/
.venv/
__pycache__/
*.pyc
.coverage

# Landing-zone data is generated at runtime (dlt/ingestion writes here) —
# never committed. The directory structure itself is kept via .gitkeep.
data/landing/*
!data/landing/.gitkeep

# dbt build artifacts (PLAN.md Step 5) — regenerated by `dbt deps`/`dbt run`.
dbt/dbt_packages/
dbt/target/
dbt/logs/
