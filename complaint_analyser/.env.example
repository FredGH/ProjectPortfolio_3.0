# Copy this file to .env and fill in all values before starting services.
# Never commit .env to git.

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── n8n ──────────────────────────────────────────────────────────────────────
N8N_PASSWORD=

# ── Ollama ───────────────────────────────────────────────────────────────────
# Model to use for triage scoring. llama3.1:8b recommended for quality.
# Use llama3.2:1b on memory-constrained machines.
OLLAMA_MODEL=llama3.1:8b

# Embedding model. Must be pulled in Ollama before starting workers.
EMBED_MODEL=nomic-embed-text

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Token from: cloudflared tunnel create complaint-analyser
# (production only — not needed for local dev)
CLOUDFLARE_TUNNEL_TOKEN=

# ── CI / Deploy ──────────────────────────────────────────────────────────────
# Set these in GitHub Actions secrets, not here.
# DEPLOY_HOST=
# DEPLOY_USER=ubuntu
# DEPLOY_SSH_KEY=
